# Copy this file to `.env.local` and fill in real values.
# Get Supabase values from: Supabase Dashboard → Project Settings → API / Database.
# `.env.local` is gitignored — never commit real secrets.

# ── Supabase ──
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=          # server-only secret (service_role or sb_secret_…)
SUPABASE_DB_PASSWORD=               # for migrations / Supabase CLI

# ── Razorpay (test mode first; live keys only at launch) ──
# From Razorpay DESKTOP dashboard → Test Mode → Account & Settings → API Keys → Generate Key
# (the mobile app does not expose Test Mode). Test keys are in .env.local as of 2026-07-06.
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=          # set when the webhook is created at deploy

# ── Email: Gmail SMTP (sends as official.skinature@gmail.com) ──
# Auth is a Google APP PASSWORD, not the account password:
#   the account needs 2-Step Verification ON, then
#   myaccount.google.com/apppasswords -> name it -> copy the 16-char code.
# Unset = every email is a graceful no-op. Test: npx tsx scripts/test-email.mts you@example.com
# GMAIL_USER=official.skinature@gmail.com
# GMAIL_APP_PASSWORD=                 # 16 chars; spaces are stripped automatically
# EMAIL_FROM=Skinature <official.skinature@gmail.com>   # optional, defaults to GMAIL_USER
# EMAIL_ADMIN=official.skinature@gmail.com              # optional, where new-order alerts go

# ── WhatsApp order notifications: Meta Cloud API (direct, NO BSP middleman) ──
# No monthly fee; utility messages ~Rs 0.115 + GST each. Needs a Meta Business
# account, a dedicated number NOT on the WhatsApp app, and an approved template.
# Unset = every WhatsApp send is a graceful no-op.
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_ACCESS_TOKEN=              # permanent system-user token
# WHATSAPP_TEMPLATE_NAME=order_confirmation
# WHATSAPP_TEMPLATE_LANG=en

# ── Cron (review-invite auto-send) ──
# CRON_SECRET=                      # any long random string; used to authorize /api/cron/*

# ── Preview lock (optional) ──
# Set on a shared Vercel preview to password-protect the whole site + mark it noindex.
# Format is "user:password". Leave UNSET in production (then it's a no-op).
# PREVIEW_BASIC_AUTH=skinature:choose-a-password
